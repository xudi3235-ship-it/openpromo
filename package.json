{
  "name": "openpromo",
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "sst dev",
    "check": "biome check --write --diagnostic-level=warn",
    "sso": "aws sso login --sso-session=promobase-dev-ray --no-browser",
    "sync_secrets": "bash scripts/sync_secrets.sh",
    "postinstall": "lefthook install",
    "typecheck": "pnpm run --parallel -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.17.1",
    "lefthook": "^1.12.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "cloudflare": "^4.5.0",
    "date-fns": "^4.1.0",
    "sst": "3.17.12",
    "valibot": "^1.1.0",
    "wrangler": "^4.33.2"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "iron-webcrypto": "0.4.0"
    }
  }
}
