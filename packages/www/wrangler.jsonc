/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpromo-www",
  "compatibility_date": "2025-09-03",
  "assets": {
    "directory": "./dist"
  },
  "env": {
    "staging": {
      "name": "openpromo-www-staging",
      "routes": [
        {
          "pattern": "staging.openpromo.app",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "openpromo-www-production",
      "routes": [
        {
          "pattern": "openpromo.app",
          "custom_domain": true
        }
      ]
    }
  }
}
