---
import BaseHead from "@components/BaseHead.astro";
import PostHog from "@components/PostHog.astro";
import Footer from "@components/sections/footer";
import Navbar from "@components/sections/navbar";

const { title, description } = Astro.props;
const dashboardUrl = import.meta.env.VITE_DASHBOARD_URL;
---

<html lang="en">
  <head>
    <PostHog />
    <BaseHead title={title} description={description} />
  </head>
  <body class={`h-screen antialiased flex flex-col`}>
    {
      /**
       * Changed from client:only to client:load so the navbar is server-rendered
       * immediately (eliminating the initial layout shift) and hydrated once
       * the page loads. If you want to delay hydration further you could use
       * client:idle, but client:load ensures interactivity is ready ASAP.
       */
    }
    <Navbar
      dashboardUrl={dashboardUrl}
      currentPage={Astro.url.pathname}
      client:load
    />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
