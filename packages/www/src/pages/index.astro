---
import { DashboardPreviewSection } from "src/components/landing/dashboard-preview-section";
import { FaqSection } from "src/components/landing/faq-section";
import { FeaturesSection } from "src/components/landing/features-section";
import { FooterSection } from "src/components/landing/footer-section";
import { HeroSection } from "src/components/landing/hero-section";
import LandingNavbar from "src/components/landing/landing-navbar";
import { TestimonialsSection } from "src/components/landing/testimonials-section";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const dashboardUrl = import.meta.env.VITE_DASHBOARD_URL;
---

<Layout>
  <LandingNavbar />
  <!-- have to do client side rendering -->
  <HeroSection client:load dashboardUrl={dashboardUrl} />
  <DashboardPreviewSection client:load />
  <FeaturesSection />
  <TestimonialsSection />
  <FaqSection />

  <FooterSection dashboardUrl={dashboardUrl} />
</Layout>
