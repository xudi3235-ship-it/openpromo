---
import { FaqSection } from "src/_components/landing/faq-section";
import { FooterSection } from "src/_components/landing/footer-section";
import LandingNavbar from "src/_components/landing/landing-navbar";
import { ComparisonSection } from "src/_components/pricing/comparison-section";
import { PricingSection } from "src/_components/pricing/pricing-section";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
const dashboardUrl = import.meta.env.VITE_DASHBOARD_URL;
---

<Layout>
  <LandingNavbar />
  <PricingSection client:load dashboardUrl={dashboardUrl} />
  <ComparisonSection client:load dashboardUrl={dashboardUrl} />
  <FaqSection />
  <FooterSection dashboardUrl={dashboardUrl} />
</Layout>
