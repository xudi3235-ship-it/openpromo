{
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off",
        "noEmptyInterface": "off",
        "noExplicitAny": "off"
      },
      "correctness": {
        "noUnusedImports": "off",
        "noUnusedVariables": "off"
      }
    }
  },
  "files": {
    "includes": ["!**/*.d.ts"]
  }
}
