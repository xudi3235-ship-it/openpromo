{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenPromo Backend API",
    "description": "Backend API for OpenPromo",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Echo",
        "operationId": "echo__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoResponse" }
              }
            }
          }
        }
      }
    },
    "/video/transcode": {
      "post": {
        "tags": ["video"],
        "summary": "Transcode Video",
        "operationId": "transcode_video_video_transcode_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TranscodeVideoRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscodeVideoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/ffprobe": {
      "post": {
        "tags": ["ffprobe"],
        "summary": "Run Ffprobe",
        "operationId": "run_ffprobe_ffprobe_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FFprobeRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FFprobeResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/job/submit": {
      "post": {
        "tags": ["jobs"],
        "summary": "Submit Job",
        "operationId": "submit_job_job_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  { "$ref": "#/components/schemas/EditVideoJobSubmitRequest" },
                  { "$ref": "#/components/schemas/AgentVideoJobSubmitRequest" }
                ],
                "title": "Req"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobSubmitResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/job/result/{call_id}": {
      "get": {
        "tags": ["jobs"],
        "summary": "Get Job Result",
        "operationId": "get_job_result_job_result__call_id__get",
        "parameters": [
          {
            "name": "call_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Call Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobResultResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/job/video/generate": {
      "post": {
        "tags": ["jobs"],
        "summary": "Generate Agent Video",
        "description": "Generate a video using the AI agent based on product information and user instructions.\n\nThis endpoint runs the video generation agent synchronously and returns the result.\nFor long-running jobs, consider using the /job/submit endpoint instead.",
        "operationId": "generate_agent_video_job_video_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VideoGenRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoGenResponse" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/experimental/ping": {
      "get": {
        "tags": ["experimental"],
        "summary": "Ping",
        "operationId": "ping_experimental_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": { "type": "string" },
                  "type": "object",
                  "title": "Response Ping Experimental Ping Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentVideoGenOutput": {
        "properties": {
          "video_url": { "type": "string", "title": "Video Url" }
        },
        "type": "object",
        "required": ["video_url"],
        "title": "AgentVideoGenOutput"
      },
      "AgentVideoJobSubmitRequest": {
        "properties": {
          "fn": { "type": "string", "const": "agent_video", "title": "Fn" },
          "data": { "$ref": "#/components/schemas/VideoGenRequest" }
        },
        "type": "object",
        "required": ["fn", "data"],
        "title": "AgentVideoJobSubmitRequest"
      },
      "EchoResponse": {
        "properties": {
          "message": { "type": "string", "title": "Message" },
          "ffmpeg_version": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Ffmpeg Version"
          },
          "error": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error"
          }
        },
        "type": "object",
        "required": ["message"],
        "title": "EchoResponse"
      },
      "EditVideoJobSubmitRequest": {
        "properties": {
          "fn": { "type": "string", "const": "edit_video", "title": "Fn" },
          "data": { "$ref": "#/components/schemas/VideoEditRequest" }
        },
        "type": "object",
        "required": ["fn", "data"],
        "title": "EditVideoJobSubmitRequest"
      },
      "FFprobeRequest": {
        "properties": {
          "input_url": {
            "type": "string",
            "title": "Input Url",
            "default": "http://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
          },
          "cmd": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Cmd"
          }
        },
        "type": "object",
        "title": "FFprobeRequest"
      },
      "FFprobeResponse": {
        "properties": {
          "output": { "type": "string", "title": "Output" },
          "error": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error"
          }
        },
        "type": "object",
        "required": ["output"],
        "title": "FFprobeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobResultResponse": {
        "properties": {
          "fn": {
            "type": "string",
            "enum": ["edit_video", "agent_video"],
            "title": "Fn"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "succeeded", "failed"],
            "title": "Status"
          },
          "result": {
            "anyOf": [
              { "$ref": "#/components/schemas/VideoEditResponse" },
              { "$ref": "#/components/schemas/VideoGenResponse" },
              { "type": "null" }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error"
          }
        },
        "type": "object",
        "required": ["fn", "status"],
        "title": "JobResultResponse"
      },
      "JobSubmitResponse": {
        "properties": { "call_id": { "type": "string", "title": "Call Id" } },
        "type": "object",
        "required": ["call_id"],
        "title": "JobSubmitResponse"
      },
      "TranscodeVideoRequest": {
        "properties": {
          "input_url": {
            "type": "string",
            "title": "Input Url",
            "default": "http://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
          },
          "platform": {
            "type": "string",
            "enum": ["ig_reel", "fb_reel"],
            "title": "Platform"
          }
        },
        "type": "object",
        "required": ["platform"],
        "title": "TranscodeVideoRequest"
      },
      "TranscodeVideoResponse": {
        "properties": {
          "output_url": { "type": "string", "title": "Output Url" },
          "transcoded": {
            "type": "boolean",
            "title": "Transcoded",
            "default": true
          },
          "error": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Error"
          }
        },
        "type": "object",
        "required": ["output_url"],
        "title": "TranscodeVideoResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      },
      "VideoEditRequest": {
        "properties": {
          "input_url": {
            "type": "string",
            "title": "Input Url",
            "default": "http://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": ["16:9", "4:3", "1:1"],
            "title": "Aspect Ratio",
            "default": "16:9"
          },
          "cadence": {
            "type": "string",
            "enum": ["daily", "weekly", "monthly"],
            "title": "Cadence",
            "default": "daily"
          }
        },
        "type": "object",
        "title": "VideoEditRequest"
      },
      "VideoEditResponse": {
        "properties": {
          "output_url": { "type": "string", "title": "Output Url" }
        },
        "type": "object",
        "required": ["output_url"],
        "title": "VideoEditResponse"
      },
      "VideoGenFailResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "failed",
            "title": "Status",
            "description": "Failure status.",
            "default": "failed"
          },
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Error message describing the failure."
          }
        },
        "type": "object",
        "required": ["error"],
        "title": "VideoGenFailResponse"
      },
      "VideoGenInProgressResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "in_progress",
            "title": "Status",
            "description": "In-progress status.",
            "default": "in_progress"
          },
          "progress": {
            "type": "number",
            "title": "Progress",
            "description": "Progress percentage of the video generation."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message describing the current progress."
          }
        },
        "type": "object",
        "required": ["progress", "message"],
        "title": "VideoGenInProgressResponse"
      },
      "VideoGenRequest": {
        "properties": {
          "product": {
            "type": "string",
            "title": "Product",
            "description": "Product context, stringfied."
          },
          "product_imgs": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Product Imgs",
            "description": "List of product images, urls."
          },
          "avatar_imgs": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Avatar Imgs",
            "description": "List of avatar images, urls."
          },
          "business": {
            "type": "string",
            "title": "Business",
            "description": "Business context, stringfied."
          },
          "user_message": {
            "type": "string",
            "title": "User Message",
            "description": "User message or instructions for video generation."
          },
          "max_turns": {
            "type": "integer",
            "title": "Max Turns",
            "description": "Maximum number of turns for the AI agent.",
            "default": 100
          }
        },
        "type": "object",
        "required": [
          "product",
          "product_imgs",
          "avatar_imgs",
          "business",
          "user_message"
        ],
        "title": "VideoGenRequest",
        "description": "request schema for our internal video generation agent."
      },
      "VideoGenResponse": {
        "properties": {
          "data": {
            "anyOf": [
              { "$ref": "#/components/schemas/VideoGenFailResponse" },
              { "$ref": "#/components/schemas/VideoGenInProgressResponse" },
              { "$ref": "#/components/schemas/VideoGenSuccessResponse" }
            ],
            "title": "Data"
          }
        },
        "type": "object",
        "required": ["data"],
        "title": "VideoGenResponse"
      },
      "VideoGenSuccessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status",
            "description": "Success status.",
            "default": "success"
          },
          "out": {
            "$ref": "#/components/schemas/AgentVideoGenOutput",
            "description": "Output from the video generation agent."
          }
        },
        "type": "object",
        "required": ["out"],
        "title": "VideoGenSuccessResponse"
      }
    },
    "securitySchemes": {
      "ModalKey": { "type": "apiKey", "in": "header", "name": "Modal-Key" },
      "ModalSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "Modal-Secret"
      }
    }
  },
  "security": [{ "ModalKey": [], "ModalSecret": [] }]
}
