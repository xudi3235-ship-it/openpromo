{
  "name": "@openpromo/dash",
  "type": "module",
  "scripts": {
    "predev": "pnpm secrets:sync && pnpm -w --filter @openpromo/core run db:migrate",
    "dev": "vite --port 3000 --host",
    "typecheck": "tsc -b --noEmit",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "deploy": "wrangler deploy",
    "deploy:staging": "pnpm build:staging && wrangler deploy -e '' && posthog-cli sourcemap inject --directory ./dist/client/assets --project OpenPromo",
    "deploy:production": "pnpm build:production && wrangler deploy -e '' && posthog-cli sourcemap inject --directory ./dist/client/assets --project OpenPromo",
    "cf-typegen": "wrangler types ./worker/worker-configuration.d.ts",
    "secrets:sync": "doppler secrets download --format env --no-file > .env"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.104",
    "ai": "^5.0.103",
    "@bufbuild/protobuf": "^2.10.1",
    "@cloudflare/stream-react": "^1.9.3",
    "@connectrpc/connect": "^2.1.1",
    "@depot/connectrpc-workers": "^2.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/standard-validator": "^0.2.0",
    "@hono/zod-validator": "^0.7.2",
    "@hookform/resolvers": "^5.2.1",
    "@openpromo/core": "workspace:*",
    "@openpromo/ui": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "^1.10.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@remixicon/react": "^4.6.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/react-devtools": "^0.8.2",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-query-devtools": "^5.85.5",
    "@tanstack/react-router": "^1.139.10",
    "@tanstack/react-router-devtools": "^1.139.10",
    "@tanstack/react-table": "^8.21.3",
    "@uppy/core": "^5.0.1",
    "@workos-inc/node": "catalog:",
    "agents": "catalog:",
    "date-fns": "^4.1.0",
    "drizzle-orm": "catalog:",
    "framer-motion": "^12.23.12",
    "hono": "catalog:",
    "hono-openapi": "^1.0.8",
    "immer": "^11.0.1",
    "lucide-react": "catalog:",
    "nanoid": "^5.1.5",
    "posthog-js": "^1.282.0",
    "posthog-node": "^5.14.1",
    "react": "catalog:",
    "react-day-picker": "^9.8.1",
    "react-dom": "catalog:",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.67.0",
    "react-icons": "^5.5.0",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.5.1",
    "simple-icons": "^15.14.0",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.6",
    "usehooks-ts": "^3.1.1",
    "web-vitals": "^5.1.0",
    "zod": "catalog:",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.15.3",
    "@cloudflare/workers-types": "^4.20251128.0",
    "@hono/vite-build": "^1.8.0",
    "@hono/vite-dev-server": "^0.23.0",
    "@tanstack/router-plugin": "^1.139.10",
    "@tsconfig/vite-react": "^7.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.2",
    "unplugin-fonts": "^1.4.0",
    "vite": "catalog:",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "catalog:"
  }
}
