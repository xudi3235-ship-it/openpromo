{
  "name": "@openpromo/dash",
  "type": "module",
  "scripts": {
    "predev": "pnpm -w --filter @openpromo/core run db:migrate && pnpm secrets:sync",
    "dev": "vite --port 3000",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "deploy": "wrangler deploy",
    "deploy:staging": "pnpm build:staging && wrangler deploy",
    "deploy:production": "pnpm build:production && wrangler deploy",
    "cf-typegen": "wrangler types ./worker/worker-configuration.d.ts",
    "secrets:sync": "doppler secrets download --format env --no-file > .env"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "^0.7.2",
    "@hookform/resolvers": "^5.2.1",
    "@openpromo/core": "workspace:*",
    "@openpromo/ui": "workspace:*",
    "@radix-ui/react-slot": "^1.2.3",
    "@remixicon/react": "^4.6.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/devtools-vite": "^0.2.12",
    "@tanstack/react-devtools": "^0.6.4",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-query-devtools": "^5.85.5",
    "@tanstack/react-router": "^1.131.7",
    "@tanstack/react-router-devtools": "^1.131.7",
    "@tanstack/react-table": "^8.21.3",
    "@workos-inc/node": "catalog:",
    "date-fns": "^4.1.0",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "immer": "^10.1.3",
    "lucide-react": "^0.539.0",
    "nanoid": "^5.1.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.62.0",
    "react-top-loading-bar": "^3.0.2",
    "simple-icons": "^15.14.0",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.6",
    "uppy": "^5.1.1",
    "web-vitals": "^5.1.0",
    "zod": "catalog:",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.2",
    "@hono/vite-build": "^1.7.0",
    "@hono/vite-dev-server": "^0.20.1",
    "@tanstack/router-plugin": "^1.131.7",
    "@tsconfig/vite-react": "^7.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
