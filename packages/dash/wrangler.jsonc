/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpromo-dash",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-11-25",
  "compatibility_flags": ["nodejs_compat"],
  // "rules": [
  //   {
  //     "type": "Data",
  //     "globs": ["./tmp/**/*"],
  //     "fallthrough": true
  //   }
  // ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/openapi/*"]
  },
  // only provide this so that we have consistent type gen
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "JUST_FOR_TESTING_ONLY_DO_NOT_USE_IN_PRODUCTION",
      "localConnectionString": "postgres://user:password@localhost:5432/databasename"
    }
  ],
  "workflows": [
    {
      "class_name": "PendingContentPublishWorkflow",
      "binding": "WORKFLOW",
      "name": "PendingContentPublishWorkflow"
    },
    {
      "class_name": "ContentBackfillWorkflow",
      "binding": "ContentBackfillWorkflow",
      "name": "ContentBackfillWorkflow"
    },
    {
      "class_name": "ProductProcessingWorkflow",
      "binding": "ProductProcessingWorkflow",
      "name": "ProductProcessingWorkflow"
    },
    {
      "class_name": "StyleComponentWorkflow",
      "binding": "StyleComponentWorkflow",
      "name": "StyleComponentWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkspacePusher",
        "class_name": "WorkspacePusher"
      },
      {
        "name": "WorkspaceSyncCoordinator",
        "class_name": "WorkspaceSyncCoordinator"
      },
      {
        "name": "ApiRateLimitCoordinator",
        "class_name": "ApiRateLimitCoordinator"
      },
      {
        "name": "ContainerBackend",
        "class_name": "ContainerBackend"
      },
      {
        "name": "VideoGenAgent",
        "class_name": "VideoGenAgent"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "66945099c2b142c0bc7a46cc5664a67d"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "browser": {
    "binding": "Browser",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "ReferenceIndex",
      "index_name": "reference-gallery-index",
      "remote": true
    }
  ],
  "containers": [
    {
      "max_instances": 2,
      "class_name": "ContainerBackend",
      "image": "../core/src/containers/Dockerfile",
      "image_build_context": "../core/src/containers",
      "instance_type": "basic"
    }
  ],
  // https://developers.cloudflare.com/workers/development-testing/wrangler-vs-vite/#when-to-use-wrangler
  // R2 does not work locally since vite plugin does not support.
  // as our backend grows we should separate to its own worker
  "r2_buckets": [
    {
      "bucket_name": "openpromo-bucket",
      "binding": "Bucket",
      "remote": true
    },
    {
      "bucket_name": "public",
      "binding": "PublicBucket",
      "remote": true
    },
    {
      "bucket_name": "openpromo-reference",
      "binding": "ReferenceBucket",
      "remote": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "WorkspaceInsightsAnalytics",
      "dataset": "workspace_insights"
    }
  ],
  "triggers": {
    "crons": [
      // daily
      "0 0 * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "queue": "jobs",
        "binding": "JobQueue"
      }
    ],
    "consumers": [
      {
        "queue": "jobs",
        "max_batch_size": 10
      }
    ]
  },
  // required for DO
  "migrations": [
    {
      "tag": "v3",
      "new_sqlite_classes": ["WorkspacePusher"],
      "renamed_classes": [
        // {
        //   "from": "Scheduler",
        //   "to": "WorkspacePusher"
        // }
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ContainerBackend"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["WorkspaceSyncCoordinator"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["ApiRateLimitCoordinator"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["VideoGenAgent"]
    }
  ],
  "env": {
    "staging": {
      "name": "openpromo-dash-staging",
      "routes": [
        {
          "pattern": "dash.staging.openpromo.app",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "id": "db4557bd64924785bdbf0e4d7cec3a87",
          "binding": "HYPERDRIVE"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WorkspacePusher",
            "class_name": "WorkspacePusher"
          },
          {
            "name": "WorkspaceSyncCoordinator",
            "class_name": "WorkspaceSyncCoordinator"
          },
          {
            "name": "ApiRateLimitCoordinator",
            "class_name": "ApiRateLimitCoordinator"
          },
          {
            "name": "ContainerBackend",
            "class_name": "ContainerBackend"
          },
          {
            "name": "VideoGenAgent",
            "class_name": "VideoGenAgent"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "66945099c2b142c0bc7a46cc5664a67d"
        }
      ],
      "containers": [
        {
          "max_instances": 2,
          "class_name": "ContainerBackend",
          "image": "../core/src/containers/Dockerfile",
          "image_build_context": "../core/src/containers",
          "instance_type": "basic"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "openpromo-bucket",
          "binding": "Bucket",
          "remote": true
        },
        {
          "bucket_name": "public",
          "binding": "PublicBucket",
          "remote": true
        },
        {
          "bucket_name": "openpromo-reference",
          "binding": "ReferenceBucket",
          "remote": true
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "WorkspaceInsightsAnalytics",
          "dataset": "workspace_insights"
        }
      ],
      // no need to duplicate DO migrations
      "workflows": [
        {
          "class_name": "PendingContentPublishWorkflow",
          "binding": "WORKFLOW",
          "name": "PendingContentPublishWorkflow"
        },
        {
          "class_name": "ContentBackfillWorkflow",
          "binding": "ContentBackfillWorkflow",
          "name": "ContentBackfillWorkflow"
        },
        {
          "class_name": "ProductProcessingWorkflow",
          "binding": "ProductProcessingWorkflow",
          "name": "ProductProcessingWorkflow"
        },
        {
          "class_name": "StyleComponentWorkflow",
          "binding": "StyleComponentWorkflow",
          "name": "StyleComponentWorkflow"
        }
      ],
      "triggers": {
        "crons": [
          // daily
          "0 0 * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "queue": "jobs",
            "binding": "JobQueue"
          }
        ],
        "consumers": [
          {
            "queue": "jobs",
            "max_batch_size": 10
          }
        ]
      },
      "vectorize": [
        {
          "binding": "ReferenceIndex",
          "index_name": "reference-gallery-index"
        }
      ]
    },
    "production": {
      "name": "openpromo-dash-production",
      "routes": [
        {
          "pattern": "dash.openpromo.app",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "id": "be71de62d7554ec49b940520b04670bd",
          "binding": "HYPERDRIVE"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "openpromo-bucket",
          "binding": "Bucket",
          "remote": true
        },
        {
          "bucket_name": "public",
          "binding": "PublicBucket",
          "remote": true
        },
        {
          "bucket_name": "openpromo-reference",
          "binding": "ReferenceBucket",
          "remote": true
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "WorkspaceInsightsAnalytics",
          "dataset": "workspace_insights"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WorkspacePusher",
            "class_name": "WorkspacePusher"
          },
          {
            "name": "WorkspaceSyncCoordinator",
            "class_name": "WorkspaceSyncCoordinator"
          },
          {
            "name": "ApiRateLimitCoordinator",
            "class_name": "ApiRateLimitCoordinator"
          },
          {
            "name": "ContainerBackend",
            "class_name": "ContainerBackend"
          },
          {
            "name": "VideoGenAgent",
            "class_name": "VideoGenAgent"
          }
        ]
      },
      "workflows": [
        {
          "class_name": "PendingContentPublishWorkflow",
          "binding": "WORKFLOW",
          "name": "PendingContentPublishWorkflow"
        },
        {
          "class_name": "ContentBackfillWorkflow",
          "binding": "ContentBackfillWorkflow",
          "name": "ContentBackfillWorkflow"
        },
        {
          "class_name": "ProductProcessingWorkflow",
          "binding": "ProductProcessingWorkflow",
          "name": "ProductProcessingWorkflow"
        },
        {
          "class_name": "StyleComponentWorkflow",
          "binding": "StyleComponentWorkflow",
          "name": "StyleComponentWorkflow"
        }
      ],
      "triggers": {
        "crons": [
          // daily
          "0 0 * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "queue": "jobs",
            "binding": "JobQueue"
          }
        ],
        "consumers": [
          {
            "queue": "jobs",
            "max_batch_size": 10
          }
        ]
      },
      "containers": [
        {
          "max_instances": 2,
          "class_name": "ContainerBackend",
          "image": "../core/src/containers/Dockerfile",
          "image_build_context": "../core/src/containers",
          "instance_type": "basic"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "66945099c2b142c0bc7a46cc5664a67d"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "browser": {
        "binding": "Browser"
      },
      "vectorize": [
        {
          "binding": "ReferenceIndex",
          "index_name": "reference-gallery-index"
        }
      ]
    }
  }
}
