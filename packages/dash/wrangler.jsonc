/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpromo-dash",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "workflows": [
    {
      "class_name": "PendingContentPublishWorkflow",
      "binding": "WORKFLOW",
      "name": "PendingContentPublishWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DURABLE_OBJECT",
        "class_name": "MyDurableObject"
      }
    ]
  },
  // required for DO
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MyDurableObject"]
    }
  ],
  "env": {
    "staging": {
      "name": "openpromo-dash-staging",
      "routes": [
        {
          "pattern": "dash.staging.openpromo.app",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "id": "a5943f8b4ea54aaea305c57f60866f9d",
          "binding": "HYPERDRIVE"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DURABLE_OBJECT",
            "class_name": "MyDurableObject"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["MyDurableObject"]
        }
      ],
      "workflows": [
        {
          "class_name": "PendingContentPublishWorkflow",
          "binding": "WORKFLOW",
          "name": "PendingContentPublishWorkflow"
        }
      ]
    },
    "production": {
      "name": "openpromo-dash-production",
      "routes": [
        {
          "pattern": "dash.openpromo.app",
          "custom_domain": true
        }
      ]
    }
  }
}
