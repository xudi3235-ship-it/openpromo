/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpromo-dash",
  "main": "worker/src/index.ts",
  // DO NOT bump this date, latest wrangler 4.37.0 +vite plugin has bug
  "compatibility_date": "2025-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/openapi/*"]
  },
  "workflows": [
    {
      "class_name": "PendingContentPublishWorkflow",
      "binding": "WORKFLOW",
      "name": "PendingContentPublishWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkspacePusher",
        "class_name": "WorkspacePusher"
      },
      {
        "name": "ContainerBackend",
        "class_name": "ContainerBackend"
      }
    ]
  },
  "containers": [
    // {
    //   "max_instances": 2,
    //   "class_name": "ContainerBackend",
    //   "image": "../core/src/containers/Dockerfile",
    //   "image_build_context": "../core/src/containers"
    // }
  ],
  "r2_buckets": [
    {
      "bucket_name": "openpromo-bucket",
      "binding": "Bucket",
      "remote": true
    }
  ],
  "triggers": {
    "crons": [
      // daily
      "0 0 * * *"
    ]
  },
  // required for DO
  "migrations": [
    {
      "tag": "v3",
      "new_sqlite_classes": ["WorkspacePusher"],
      "renamed_classes": [
        // {
        //   "from": "Scheduler",
        //   "to": "WorkspacePusher"
        // }
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ContainerBackend"]
    }
  ],
  "env": {
    "staging": {
      "name": "openpromo-dash-staging",
      "routes": [
        {
          "pattern": "dash.staging.openpromo.app",
          "custom_domain": true
        }
      ],
      "hyperdrive": [
        {
          "id": "db4557bd64924785bdbf0e4d7cec3a87",
          "binding": "HYPERDRIVE"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WorkspacePusher",
            "class_name": "WorkspacePusher"
          },
          {
            "name": "ContainerBackend",
            "class_name": "ContainerBackend"
          }
        ]
      },
      "containers": [
        {
          "max_instances": 2,
          "class_name": "ContainerBackend",
          "image": "../core/src/containers/Dockerfile"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "openpromo-bucket",
          "binding": "Bucket",
          "remote": true
        }
      ],
      // no need to duplicate DO migrations
      "workflows": [
        {
          "class_name": "PendingContentPublishWorkflow",
          "binding": "WORKFLOW",
          "name": "PendingContentPublishWorkflow"
        }
      ],
      "triggers": {
        "crons": [
          // daily
          "0 0 * * *"
        ]
      }
    },
    "production": {
      "name": "openpromo-dash-production",
      "routes": [
        {
          "pattern": "dash.openpromo.app",
          "custom_domain": true
        }
      ]
    }
  }
}
