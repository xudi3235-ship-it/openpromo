{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "logpush": true,
  "upload_source_maps": true,
  // TODO: figure this out
  // "build": {
  //   "cwd": "../web-ui",
  //   "command": "pnpm build",
  //   "watch_dir": "../web-ui"
  // },
  "assets": {
    "directory": "../web-ui/dist",
    "not_found_handling": "single-page-application"
  },
  // handle .raw.js esbuild
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.raw.js"],
      "fallthrough": true
    }
  ]
}