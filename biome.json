{
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "files": {
       "includes": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.jsx",
            "**/*.json",
            "**/*.md",
            "!**/.node_modules/**",
            "!**/.vscode/**",
            "!**/.git/**",
            "!**/.idea/**",
            "!**/.sst/**",
            "!**/.next/**"
        ]
    },
    "formatter": {
        "lineWidth": 100,
        "indentStyle": "space",
        "indentWidth": 4
    }
}
